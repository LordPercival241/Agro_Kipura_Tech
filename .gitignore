# ─────────────────────────────────────────────────────────────
# .gitignore - AgroPredict
# ─────────────────────────────────────────────────────────────

# ──── Frontend (Next.js) ────
node_modules/
.next/
out/
build/
dist/
.env*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ──── Backend (Python) ────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
env/
.env

# Archivos generados en tiempo de ejecución (no versionar)
Backend/telemetry_log.csv
Backend/*.pkl

# ──── PlatformIO (ESP32) ────
ESP32_Node/.pio/
ESP32_Node/.vscode/

# ──── Sistema Operativo ────
.DS_Store
Thumbs.db
*.log

# ──── IDE ────
.idea/
.vscode/
